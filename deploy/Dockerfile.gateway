# Rust gateway image.
# Multi-stage build: compiler image for the build, slim runtime image.
# Build context must be the repository root:
#   docker build -f deploy/Dockerfile.gateway -t inference-gateway .
#
# NOTE: the builder must stay on a recent Rust (>= 1.85): transitive
# deps (idna_adapter) now use edition2024, which older Cargo rejects.
FROM rust:1-bookworm AS builder
WORKDIR /app
COPY Cargo.toml ./
COPY src/ ./src/
RUN cargo build --release

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /app/target/release/rust-gpu-inference-gateway /usr/local/bin/gateway
EXPOSE 8080
ENV BIND_ADDR=0.0.0.0:8080 \
    CORE_URL=http://inference_core:8081
ENTRYPOINT ["gateway"]